---
import { rawSlides } from '../data/trex-slides';
import SeminarDeck from './SeminarDeck.astro';
const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const trexAssetPrefix = `${assetBase}/trex/`;
const withPublicAssetBase = (html: string) => html.replaceAll('src="/trex/', `src="${trexAssetPrefix}`);
const toSlidePoint = (text: string) => {
  const normalized = text.replace(/\s+/g, ' ').trim();
  if (normalized.length <= 140) return normalized;
  const firstSentence = normalized.match(/^.*?(?:(?<=[가-힣])\.|[!?]|[A-Za-z)\]]\.(?=\s|$))/u)?.[0];
  if (firstSentence && firstSentence.length >= 40 && firstSentence.length <= 180) {
    return firstSentence.trim();
  }
  const commaPoint = normalized.split(/[,，]/).slice(0, 2).join(',').trim();
  if (commaPoint.length >= 40 && commaPoint.length <= 150) return `${commaPoint}.`;
  return normalized;
};

const inferVisualVariant = (slide: { visual?: string; layout?: string; variant?: string }) => {
  const visual = slide.visual ?? '';
  if (visual.includes('trex-apply-toothpaste')) return 'strip';
  if (visual.includes('<img')) return 'figure';
  if (visual.includes('plot-frame')) return 'plot';
  if (
    visual.includes('expert-spec-card') ||
    visual.includes('vqvae-loss-map') ||
    visual.includes('equation-panel') ||
    visual.includes('runtime-cache')
  ) {
    return slide.variant === 'visual-tight' ? 'card-narrow' : 'card';
  }
  if (visual.includes('<table')) return visual.includes('wide-table') ? 'table-wide' : 'table';
  if (
    visual.includes('compact-diagram') ||
    visual.includes('dataset-funnel') ||
    visual.includes('setup-rubric-grid') ||
    visual.includes('conditioning-flow') ||
    visual.includes('principle-map') ||
    visual.includes('two-column') ||
    visual.includes('tactile-encoder-map')
  ) {
    return 'diagram';
  }
  return slide.layout === 'stack' ? 'wide' : 'medium';
};


const slides = rawSlides.map((slide: (typeof rawSlides)[number] & { visualVariant?: string }) => ({
  ...slide,
  body: slide.body?.map(toSlidePoint).slice(0, 2),
  visualVariant: slide.visualVariant ?? inferVisualVariant(slide),
  visual: slide.visual ? withPublicAssetBase(slide.visual) : slide.visual
}));
---

<SeminarDeck slides={slides} contentId="trex" />
