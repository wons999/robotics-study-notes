---
export interface Slide {
  eyebrow: string;
  title: string;
  kicker: string;
  layout?: string;
  variant?: string;
  visualVariant?: string;
  body?: string[];
  bullets: string[];
  insight?: string;
  visual?: string;
}
interface Props { slides: Slide[]; contentId?: string }
const { slides, contentId } = Astro.props;
---

 
<section class="seminar-deck" data-seminar-deck data-content={contentId}>
  <div class="deck-shell">
    <div class="deck-toolbar" aria-label="Seminar deck controls">
      <button class="icon-button" type="button" data-prev aria-label="Previous slide" title="Previous slide">‹</button>
      <div class="slide-status">
        <span data-current>1</span>
        <span>/</span>
        <span>{slides.length}</span>
      </div>
      <button class="icon-button" type="button" data-next aria-label="Next slide" title="Next slide">›</button>
      <button class="deck-button" type="button" data-fullscreen aria-pressed="false">Fullscreen</button>
    </div>
    <div class="progress-track" aria-hidden="true">
      <span data-progress></span>
    </div>

    <div class="slides">
      {slides.map((slide, index) => (
        <article class:list={['slide', slide.layout && `slide-${slide.layout}`, slide.variant && `slide-${slide.variant}`, slide.visualVariant && `visual-${slide.visualVariant}`, index === 0 && 'is-active']} data-slide={index + 1}>
          <div class="slide-copy">
            <p class="eyebrow">{slide.eyebrow}</p>
            <h2>{slide.title}</h2>
            <p class="kicker">{slide.kicker}</p>
            {slide.body && (
              <div class="slide-body">
                {slide.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            )}
            <ul>
              {slide.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            {slide.insight && (
              <div class="slide-insight">
                <p>{slide.insight}</p>
              </div>
            )}
          </div>
          <div class="slide-visual" set:html={slide.visual} />
        </article>
      ))}
    </div>
    <div class="image-lightbox" data-image-lightbox hidden>
      <button class="lightbox-backdrop" type="button" data-lightbox-close aria-label="Close expanded image"></button>
      <div class="lightbox-panel" role="dialog" aria-modal="true" aria-label="Expanded figure">
        <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close expanded image">×</button>
        <img data-lightbox-image alt="" />
        <p data-lightbox-caption></p>
      </div>
    </div>
  </div>
</section>

<script is:inline src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/seminar-controls.js`}></script>

<style>
  .seminar-deck {
    margin: 2rem 0 3rem;
  }

  .deck-shell {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
    overflow: hidden;
  }

  .deck-toolbar {
    display: grid;
    grid-template-columns: 2.75rem minmax(4rem, 1fr) 2.75rem auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
  }

  .image-lightbox[hidden] {
    display: none;
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 2vw, 2rem);
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: color-mix(in srgb, var(--sl-color-black) 84%, transparent);
    cursor: zoom-out;
  }

  .lightbox-panel {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.6rem;
    width: min(96vw, 1600px);
    height: min(92vh, 960px);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
    padding: 0.8rem;
    box-shadow: 0 24px 70px color-mix(in srgb, var(--sl-color-black) 60%, transparent);
  }

  .lightbox-panel img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    background: white;
    border-radius: 6px;
  }

  .lightbox-panel p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    cursor: pointer;
    font-size: 1.3rem;
    line-height: 1;
  }

  .icon-button,
  .deck-button {
    height: 2.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .icon-button {
    width: 2.25rem;
    font-size: 1.6rem;
    line-height: 1;
  }

  .deck-button {
    padding: 0 0.85rem;
    font-size: 0.85rem;
  }

  .icon-button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .slide-status {
    justify-self: center;
    display: inline-flex;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-2);
  }

  .progress-track {
    height: 0.3rem;
    background: var(--sl-color-gray-6);
  }

  .progress-track span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--sl-color-accent);
    transition: width 180ms ease;
  }

  .slides {
    position: relative;
    min-height: 760px;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slides {
    container-type: inline-size;
    aspect-ratio: 1920 / 966;
    min-height: 0;
    height: auto;
    overflow: hidden;
  }

  .slide {
    display: none;
    margin: 0;
    min-height: 760px;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .slide.is-active {
    display: grid;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide {
    box-sizing: border-box;
    position: absolute;
    inset: 0 auto auto 0;
    width: 1920px;
    height: 966px;
    min-height: 0;
    padding: clamp(0.75rem, 1.6vw, 2.5rem);
    gap: clamp(0.6rem, 1.2vw, 2rem);
    align-items: center;
    overflow: hidden;
    transform: scale(calc(100cqw / 1920px));
    transform-origin: top left;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-copy,
  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-visual {
    box-sizing: border-box;
    min-height: 0;
    height: auto;
    max-height: calc(100vh - 6rem);
    overflow: auto;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .eyebrow {
    margin-bottom: 0.3rem;
    font-size: clamp(0.98rem, 0.84vw, 2.3rem);
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide h2 {
    font-size: clamp(2.38rem, 2.72vw, 7.1rem);
    line-height: 1.05;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .kicker {
    margin: 0.65rem 0 0.75rem;
    font-size: clamp(1.32rem, 1.2vw, 3.24rem);
    line-height: 1.34;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-body {
    gap: 0.55rem;
    margin-bottom: 0.75rem;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-body p,
  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide li {
    font-size: clamp(1.26rem, 1.18vw, 3.04rem);
    line-height: 1.32;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide ul {
    gap: 0.42rem;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-insight {
    margin-top: 0.55rem;
    padding-top: 0.55rem;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-insight p {
    font-size: clamp(1.1rem, 1vw, 2.5rem);
    line-height: 1.28;
  }

  .seminar-deck:not(:fullscreen):not(.is-fullscreen) .slide-visual {
    min-height: 0;
    padding: 0.65rem;
  }

  .slide-wide {
    grid-template-columns: 1fr;
    align-items: start;
    gap: 0.8rem;
    min-height: 0;
    padding: 0.8rem;
  }

  .slide-stack {
    grid-template-columns: 1fr;
    grid-template-rows: auto minmax(280px, 1fr);
    align-items: stretch;
  }

  .slide-split {
    grid-template-columns: minmax(0, 0.85fr) minmax(520px, 1.15fr);
    align-items: center;
  }

  .slide-fill {
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
    align-items: center;
  }

  .slide-visual-tight {
    grid-template-columns: minmax(0, 0.9fr) minmax(520px, 1.1fr);
  }

  .slide-visual-tight .slide-visual {
    place-items: center;
  }

  .slide-wide .kicker {
    margin: 0.55rem 0 0.6rem;
    line-height: 1.42;
  }

  .slide-wide .slide-body {
    gap: 0.45rem;
    margin-bottom: 0.6rem;
  }

  .slide-wide ul {
    gap: 0.35rem;
  }

  .slide-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--sl-color-accent-high);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .slide h2 {
    margin: 0;
    font-size: clamp(1.85rem, 3vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .kicker {
    margin: 1rem 0 1rem;
    color: var(--sl-color-gray-2);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .slide-body {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }

  .slide-body p {
    margin: 0;
    line-height: 1.65;
    color: var(--sl-color-gray-1);
  }

  .slide ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  .slide li {
    line-height: 1.5;
  }

  .slide-insight {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .slide-insight p {
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }

  .slide-visual {
    min-height: 360px;
    display: grid;
    place-items: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    padding: 1rem;
    background: #2b3642;
    border-color: rgba(255, 255, 255, 0.55);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.14),
      0 20px 44px rgba(0, 0, 0, 0.42);
    overflow: auto;
  }

  .slide-wide .slide-visual {
    min-height: 0;
    place-items: stretch;
    padding: 0.7rem;
  }

  .slide-stack .slide-visual {
    min-height: 320px;
    place-items: center;
  }

  .slide-visual img {
    display: block;
    max-width: 100%;
    max-height: 520px;
    object-fit: contain;
    border-radius: 6px;
  }

  .three-problems,
  .recipe,
  .takeaway-stack {
    display: grid;
    gap: 0.8rem;
    width: 100%;
  }

  .three-problems span,
  .recipe span,
  .takeaway-stack span,
  .appendix-grid span,
  .taxonomy span {
    display: grid;
    place-items: center;
    min-height: 4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg);
    font-weight: 700;
    text-align: center;
  }

  .taxonomy,
  .flow,
  .timeline {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    align-items: center;
  }

  .taxonomy {
    grid-template-columns: 1fr auto 1fr auto 1fr;
  }

  .flow {
    grid-template-columns: 0.8fr 1fr 0.9fr 1fr 0.8fr;
  }

  .flow span,
  .flow i,
  .timeline span,
  .module-card,
  .questions p {
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg);
    padding: 1rem;
    text-align: center;
  }

  .module-card {
    width: 100%;
    min-height: 18rem;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.7rem;
  }

  .module-card h3 {
    margin: 0;
    font-size: 1.8rem;
  }

  .module-card p {
    margin: 0;
  }

  .flow i {
    color: var(--sl-color-accent-high);
    font-style: normal;
    font-weight: 700;
  }

  .timeline {
    grid-template-columns: repeat(5, 1fr);
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
  }

  .two-column > div {
    min-height: 14rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg);
    padding: 1rem;
  }

  .appendix-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    width: 100%;
  }

  .mini-table {
    display: table;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    justify-self: stretch;
    box-sizing: border-box;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid #ffffff;
    background: var(--sl-color-bg);
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.9rem;
  }

  .mini-table th,
  .mini-table td {
    border: 0;
    border-right: 1px solid #ffffff;
    border-bottom: 1px solid #ffffff;
    padding: 0.65rem;
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .mini-table th {
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
  }

  .mini-table th:last-child,
  .mini-table td:last-child {
    border-right: 0;
  }

  .mini-table tr:last-child th,
  .mini-table tr:last-child td {
    border-bottom: 0;
  }

  .result-table td:nth-child(2),
  .result-table th:nth-child(2) {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .dataset-funnel,
  .expert-card,
  .denoise-card,
  .fast-refine-card,
  .cascaded-flow,
  .async-clock,
  .training-stages,
  .principle-map,
  .runtime-cache {
    width: 100%;
  }

  .dataset-funnel,
  .expert-card,
  .denoise-card,
  .fast-refine-card,
  .async-clock,
  .runtime-cache {
    display: grid;
    gap: 0.75rem;
  }

  .funnel-row,
  .expert-flow,
  .refine-grid,
  .training-stages,
  .principle-map {
    display: grid;
    gap: 0.65rem;
  }

  .funnel-row {
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .funnel-row span,
  .funnel-step,
  .pair-examples span,
  .expert-flow span,
  .refine-grid span,
  .denoise-lane span,
  .cascaded-flow div,
  .clock-row span,
  .training-stages div,
  .principle-map div,
  .cache-main {
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 8px;
    background: var(--sl-color-bg);
    padding: 0.8rem;
  }

  .funnel-row span,
  .funnel-step {
    text-align: center;
    font-weight: 700;
  }

  .funnel-arrow,
  .cache-arrow {
    color: var(--sl-color-accent-high);
    font-weight: 800;
    text-align: center;
  }

  .funnel-step.emphasis,
  .training-stages .focus,
  .cache-main.accent {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .pair-examples {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .pair-examples span {
    text-align: center;
    font-size: 0.86rem;
    color: var(--sl-color-gray-1);
  }

  .expert-card,
  .denoise-card,
  .fast-refine-card {
    min-height: 20rem;
    align-content: center;
  }

  .expert-card h3,
  .denoise-card h3,
  .fast-refine-card h3 {
    margin: 0;
    font-size: 1.65rem;
  }

  .expert-card p,
  .fast-refine-card p,
  .expert-card small,
  .fast-refine-card small {
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .expert-flow,
  .refine-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .expert-flow span,
  .refine-grid span {
    text-align: center;
    font-weight: 700;
  }

  .denoise-lane,
  .cascaded-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 0.65rem;
    align-items: stretch;
  }

  .denoise-lane i,
  .cascaded-flow i {
    align-self: center;
    color: var(--sl-color-accent-high);
    font-style: normal;
    font-weight: 800;
    text-align: center;
  }

  .cascaded-flow div {
    display: grid;
    gap: 0.35rem;
    min-height: 8rem;
    align-content: center;
    text-align: center;
  }

  .cascaded-flow b,
  .training-stages b,
  .principle-map b {
    justify-self: center;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  .cascaded-flow small,
  .training-stages small,
  .principle-map small {
    color: var(--sl-color-gray-2);
  }

  .micro-table {
    display: table;
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid #ffffff;
    overflow: hidden;
    border-radius: 8px;
    background: var(--sl-color-bg);
  }

  .micro-table td {
    border: 0;
    border-right: 1px solid #ffffff;
    border-bottom: 1px solid #ffffff;
    padding: 0.55rem 0.65rem;
  }

  .micro-table td:first-child {
    width: 40%;
    color: var(--sl-color-gray-2);
  }

  .clock-row {
    display: grid;
    grid-template-columns: 7rem repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    align-items: stretch;
  }

  .clock-row strong {
    display: grid;
    place-items: center;
    color: var(--sl-color-accent-high);
  }

  .clock-row span {
    display: grid;
    place-items: center;
    min-height: 4.25rem;
    text-align: center;
  }

  .clock-row.control {
    grid-template-columns: 7rem 1fr 1fr;
  }

  .training-stages {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .training-stages div,
  .principle-map div {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-height: 11rem;
  }

  .training-stages strong,
  .principle-map span {
    font-weight: 800;
  }

  .principle-map {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .runtime-cache {
    align-content: center;
  }

  .cache-main {
    display: grid;
    gap: 0.6rem;
  }

  .cache-main span {
    display: block;
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    background: var(--sl-color-gray-6);
  }

  .questions {
    display: grid;
    gap: 0.75rem;
    width: 100%;
  }

  .questions p {
    margin: 0;
    text-align: left;
  }

  .seminar-deck:fullscreen,
  .seminar-deck.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    background: var(--sl-color-bg);
    isolation: isolate;
  }

  .seminar-deck:fullscreen .deck-shell,
  .seminar-deck.is-fullscreen .deck-shell {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
  }

  .seminar-deck:fullscreen .slides,
  .seminar-deck.is-fullscreen .slides {
    min-height: 0;
    height: auto;
    overflow: hidden;
  }

  .seminar-deck:fullscreen .slide,
  .seminar-deck.is-fullscreen .slide {
    box-sizing: border-box;
    min-height: 0;
    height: 100%;
    padding: clamp(0.75rem, 1.6vw, 2.5rem);
    gap: clamp(0.6rem, 1.2vw, 2rem);
    align-items: center;
    overflow: hidden;
  }

  .seminar-deck:fullscreen .slide-copy,
  .seminar-deck.is-fullscreen .slide-copy,
  .seminar-deck:fullscreen .slide-visual,
  .seminar-deck.is-fullscreen .slide-visual {
    box-sizing: border-box;
    min-height: 0;
    height: auto;
    max-height: calc(100vh - 6rem);
    overflow: auto;
  }

  .seminar-deck:fullscreen .eyebrow,
  .seminar-deck.is-fullscreen .eyebrow {
    margin-bottom: 0.3rem;
    font-size: clamp(0.98rem, 0.84vw, 2.3rem);
